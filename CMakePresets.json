{
    "version": 10,
    "configurePresets": [
        {
            "name" : "ninja-base-multi",
            "hidden" : true,
            "generator" : "Ninja Multi-Config",
            "binaryDir" : "${sourceDir}/build/${presetName}",
            "architecture": {
                "value" : "x64",
                "strategy" : "external"
            },
            "toolset": {
                "value" : "host=x64",
                "strategy" : "external"
            }
        },
        {
            "name": "ninja-msvc",
            "displayName" : "Windows x64 MSVC",
            "inherits" : "ninja-base-multi",
            "cacheVariables": {
                "CMAKE_C_COMPILER" : "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name" : "ninja-clang",
            "displayName" : "Windows x64 Clang",
            "inherits" : "ninja-base-multi",
            "cacheVariables" : {
                "CMAKE_C_COMPILER" : "clang-cl.exe",
                "CMAKE_CXX_COMPILER" : "clang-cl.exe"
            }
        },
        {
            "name" : "emscripten",
            "displayName" : "Emscripten",
            "generator" : "Ninja",
            "binaryDir" : "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-ninja-msvc-debug",
            "description": "Builds the project using the Windows x64 MSVC (Ninja) configure preset",
            "configurePreset": "ninja-msvc",
            "configuration": "Debug"
        },
        {
            "name": "windows-ninja-clang-debug",
            "description": "Builds the project using the Windows x64 Clang (Ninja) configure preset",
            "configurePreset": "ninja-clang",
            "configuration": "Debug"
        },
        {
            "name" : "windows-ninja-msvc-relwithdebinfo",
            "description" : "Builds the project using the Windows x64 MSVC (Ninja) configure preset",
            "configurePreset" : "ninja-msvc",
            "configuration" : "RelWithDebInfo"
        },
        {
            "name" : "windows-ninja-clang-relwithdebinfo",
            "description" : "Builds the project using the Windows x64 Clang (Ninja) configure preset",
            "configurePreset" : "ninja-clang",
            "configuration" : "RelWithDebInfo"
        },
        {
            "name" : "emscripten-build",
            "description" : "Builds the project using the Emscripten configure preset",
            "configurePreset" : "emscripten"
        }
    ]
}