{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Shader Compiler [Release] (C++)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/shaders/Release/OceanShaderCompiler.exe",
            "args": ["--output", "${workspaceFolder}/include/generated/OceanShaders.hpp", "--O3", "--wave-variants", "${workspaceFolder}/shaders/compute/OceanFft.slang" ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "console": "externalTerminal"
        },
        {
            "name": "Launch Shader Compiler [RelWithDebInfo] (C++)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/shaders/RelWithDebInfo/OceanShaderCompiler.exe",
            "args": ["--output", "${workspaceFolder}/include/generated/OceanShaders.hpp", "--O3", "--wave-variants", "${workspaceFolder}/shaders/compute/OceanFft.slang" ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "console": "externalTerminal"
        },
        {
            "name": "Launch Shader Compiler [Debug] (C++)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/shaders/Debug/OceanShaderCompiler.exe",
            "args": ["--output", "${workspaceFolder}/include/generated/OceanShaders.hpp", "--O3", "--wave-variants", "${workspaceFolder}/shaders/compute/OceanFft.slang" ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "console": "externalTerminal"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}