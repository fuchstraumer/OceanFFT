{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch OceanFFT [Native]",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${command:cmake.getLaunchTargetDirectory}",
            "environment": [],
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Shader Compiler [Release]",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/shaders/Release/OceanShaderCompiler.exe",
            "args": ["--output", "${workspaceFolder}/include/generated/OceanShaders.hpp", "--03", "${workspaceFolder}/shaders/compute/OceanFft.slang" ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Shader Compiler [RelWithDebInfo]",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/shaders/RelWithDebInfo/OceanShaderCompiler.exe",
            "args": ["--output", "${workspaceFolder}/include/generated/OceanShaders.hpp", "--O3", "${workspaceFolder}/shaders/compute/OceanFft.slang" ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Shader Compiler [Debug]",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/shaders/Debug/OceanShaderCompiler.exe",
            "args": ["--output", "${workspaceFolder}/include/generated/OceanShaders.hpp", "${workspaceFolder}/shaders/compute/OceanFft.slang" ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}