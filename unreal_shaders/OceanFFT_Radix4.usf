#include "OceanFFT_Common.ush"
/*
    https://github.com/gasgiant/Ocean-URP
    ^ Implementation of GPU FFT I really like, and for which I admire a few key points:
    - Recomputes twiddle factors on the fly, rather than storing them in a texture. This is a performance win because it avoids texture reads and allows for more efficient use of registers.
    - Unrolls the loop so we do everything in a single dispatch
    - parametrizes things like inverting, permute, scaling, etc on uniforms

    However, it uses DIF - meaning that we have to change some logic to use DIT, and we use that because it means we increase our stride
    size used during the butterfly operations incrementally (as powers of 2).... so we can use subgroup ops for many of the early stages
    Fewer barriers, more trying to saturate the GPU with work
*/

#define FFT_USE_WAVE_OPS 0
#define FFT_SIZE_MIN 256
#define FFT_SIZE_REGULAR 512
#define FFT_SIZE_LARGE 1024

#ifndef FFT_SIZE
#define FFT_SIZE FFT_SIZE_REGULAR
#endif

#if FFT_SIZE == FFT_SIZE_MIN
    #define FFT_LOG2_SIZE 8
#elif FFT_SIZE == FFT_SIZE_REGULAR
    #define FFT_LOG2_SIZE 9
#elif FFT_SIZE == FFT_SIZE_LARGE
    #define FFT_LOG2_SIZE 10
#endif

#if COMPILER_SUPPORTS_WAVE_SIZE
	WAVESIZE(32)
    #define FFT_USE_WAVE_OPS 1
#endif

#if FFT_USE_WAVE_OPS
    // WaveSize is only ever guaranteed to be 32, and the UE shader compiler makes sure to set this
    // by default for all platforms as far as I can tell (at least for desktop and console)
    #define FFT_LOG2_WAVE_SIZE 5
#else
    // We use this as our start index for the groupshared fft implementation,
    // so this way the waveops version just means some extra code before the baseline version
    // and a later starting idnex for the groupshared fft implementation, which is a nice way to avoid code duplication
    #define FFT_LOG2_WAVE_SIZE 0
#endif

// store shared data as half4, to reduce LDS burden (and because the error shouldn't be visible in the heightfield)
groupshared half4 s_SharedDataA[FFT_SIZE];
groupshared half4 s_SharedDataB[FFT_SIZE];

static const float FFT_PI = 3.1415927f;
static const float FFT_2_PI = 6.2831853f;

bool Transpose;
bool Inverse;

// (x,y) : pixel coordinates (z) : cascade
// (each cascade being a different resolution of the FFT, for LOD purposes)
RWTexture2DArray<half4> Target;

// store shared data as half4, to reduce LDS burden (and because the error shouldn't be visible in the heightfield)
groupshared half4 s_SharedDataA[FFT_SIZE];
groupshared half4 s_SharedDataB[FFT_SIZE];

static const float FFT_PI = 3.1415927f;
static const float FFT_2_PI = 6.2831853f;

//=============================================================================
// Radix-4 IFFT
//
// Requires FFT_LOG2_SIZE to be even (FFT_SIZE_MIN=256, FFT_SIZE_LARGE=1024).
// FFT_SIZE_REGULAR (512) has an odd log2 and is NOT supported here -- use
// FFT_Radix2_ComputeCS for that resolution instead of trying to force it
// through this path.
//
// The wave portion (WAVESIZE=32, i.e. 5 bits) can't be evenly covered by
// radix-4 stages alone -- log4(32) = 2.5 -- so it's decomposed as 2 radix-4
// stages + 1 radix-2 stage. Whatever bits remain after that get the same
// treatment: as many radix-4 stages as fit, then one trailing radix-2 stage
// if the remainder is odd (which it always is here, since FFT_LOG2_SIZE is
// even and the wave portion eats an odd number of bits).
//=============================================================================

#if (FFT_LOG2_SIZE % 2) != 0
    #error "Radix-4 path requires an even FFT_LOG2_SIZE (256 or 1024). Use FFT_Radix2_ComputeCS for 512."
#endif

// multiply by +i / -i respectively: free, just a component swap + sign flip
float2 ComplexMulI(float2 a)
{
    return float2(-a.y, a.x);
}
float2 ComplexMulNegI(float2 a)
{
    return float2(a.y, -a.x);
}

// Base-4 digit-reversal of the low FFT_LOG2_SIZE bits of idx.
uint DigitReverse4(uint idx)
{
    if (FFT_LOG4_REMAINDER == 0)
    {
        // Unchanged - this is correct as-is for even FFT_LOG2_SIZE.
        uint x = idx;
        x = ((x >> 2) & 0x33333333) | ((x & 0x33333333) << 2);
        x = ((x & 0x0F0F0F0F) << 4) | ((x & 0xF0F0F0F0) >> 4);
        x = ((x & 0x00FF00FF) << 8) | ((x & 0xFF00FF00) >> 8);
        x = (x << 16) | (x >> 16);
        return x >> (32u - FFT_LOG2_SIZE);
    }
    else
    {
        // Odd FFT_LOG2_SIZE (e.g. 512): bit-position permutation pi(i), verified
        // against the actual radix-4 x4 + radix-2 stage order in DoIFFT_Radix4.
        const uint L = FFT_LOG2_SIZE;
        uint result = 0u;
        [unroll(FFT_LOG2_SIZE)]
        for (uint i = 0; i < L; ++i)
        {
            if ((idx >> i) & 1u)
            {
                uint pi;
                if (i == 0)
                {
                    pi = L - 1u;
                }
                else if ((i & 1u) == 0u)
                {
                    pi = L - i;
                }
                else
                {
                    pi = L - 2u - i;
                }
                result |= (1u << pi);
            }
        }
        return result;
    }
}

void ButterflyValues_Radix2(uint stage, uint outputIndex, out uint2 inputIndices, out float2 phaseRotation)
{
    const uint logStep = 1u << stage; // 2^stage
    const uint groupSize = logStep << 1;
    const uint j = outputIndex & (logStep - 1); // outputIndex % logStep
    const uint groupBase = outputIndex & ~(groupSize - 1); // outputIndex with its low bits cleared
    const uint lowerInput = groupBase + j;
    const float theta = -FFT_2_PI / groupSize * j;
    phaseRotation = ComplexExp(theta);
    phaseRotation.y *= -1.0f; // we are always doing the IFFT, so we need to conjugate the phase rotation
    inputIndices = uint2(lowerInput, lowerInput + logStep);
}

// logStep is passed explicitly (rather than derived as 4^stage) because the
// mixed radix-4/radix-2 decomposition means the stride doesn't always advance
// by a clean power of 4 between calls -- it advances by whatever the previous
// stage consumed, 1 or 2 bits.
void Radix4Twiddles(uint logStep, uint outputIndex, out float2 twiddle1, out float2 twiddle2, out float2 twiddle3)
{
    const uint groupSize = logStep << 2; // 4 * logStep
    const uint j = outputIndex & (logStep - 1);
    const float theta = -FFT_2_PI / groupSize * j;
    twiddle1 = ComplexExp(theta);
    twiddle2 = ComplexExp(2.0f * theta);
    twiddle3 = ComplexExp(3.0f * theta);
    // conjugate all three, same as the radix-2 path -- we're always doing the IFFT
    twiddle1.y *= -1.0f;
    twiddle2.y *= -1.0f;
    twiddle3.y *= -1.0f;
}

void ButterflyValues_Radix4(uint logStep, uint outputIndex, out uint4 inputIndices, out float2 twiddle1, out float2 twiddle2, out float2 twiddle3)
{
    Radix4Twiddles(logStep, outputIndex, twiddle1, twiddle2, twiddle3);
    const uint groupSize = logStep << 2;
    const uint j = outputIndex & (logStep - 1);
    const uint groupBase = outputIndex & ~(groupSize - 1);
    inputIndices = uint4(
        groupBase + j,
        groupBase + j + logStep,
        groupBase + j + 2 * logStep,
        groupBase + j + 3 * logStep);
}

// Standard radix-4 DIT combine on 4 already-twiddled inputs (a0's twiddle is
// implicitly 1, so the caller just passes it through untouched).
// NOTE: the sign of the +/-i rotation below is conjugated to match the
// twiddle conjugation above, for IFFT. Verify this against a small (N=4 or
// N=16) reference transform before trusting it on real data -- a sign error
// here is the classic radix-4 bug, and it won't look obviously wrong, just
// quietly incorrect.
void Radix4Combine(float4 a0, float4 a1, float4 a2, float4 a3, out float4 y0, out float4 y1, out float4 y2, out float4 y3)
{
    const float4 s02p = a0 + a2;
    const float4 s02m = a0 - a2;
    const float4 s13p = a1 + a3;
    const float4 s13m = a1 - a3;

    y0 = s02p + s13p;
    y2 = s02p - s13p;

    const float4 rotP = float4(ComplexMulI(s13m.xy),    ComplexMulI(s13m.zw));
    const float4 rotM = float4(ComplexMulNegI(s13m.xy), ComplexMulNegI(s13m.zw));

    y1 = s02m + rotP;
    y3 = s02m + rotM;
}

half4 DoIFFT_Radix4(in const uint threadIdx, in const half4 input)
{
    const uint digitReversedIdx = DigitReverse4(threadIdx);
    s_SharedDataA[digitReversedIdx] = input;
    GroupMemoryBarrierWithGroupSync();

    bool pingPong = false;
    uint startStage = 0;

#if FFT_USE_WAVE_OPS
    float4 threadData = s_SharedDataA[threadIdx];

    // 2 radix-4 stages: bits 0-3, i.e. 16 lanes
    // this one actually unrolls, in RGA at least!
    [unroll(2)]
    for (uint stage = 0; stage < 2; ++stage)
    {
        const uint logStep = 1u << (2u * stage); // 1, 4
        float2 tw1, tw2, tw3;
        Radix4Twiddles(logStep, threadIdx, tw1, tw2, tw3);

        const uint lane = WaveGetLaneIndex();
        const uint digitShift = 2u * stage;
        const uint groupBase = lane & ~(3u << digitShift);

        const float4 v0 = WaveReadLaneAt(threadData, groupBase | (0u << digitShift));
        const float4 v1 = WaveReadLaneAt(threadData, groupBase | (1u << digitShift));
        const float4 v2 = WaveReadLaneAt(threadData, groupBase | (2u << digitShift));
        const float4 v3 = WaveReadLaneAt(threadData, groupBase | (3u << digitShift));

        const float4 a0 = v0;
        const float4 a1 = float4(ComplexMul(tw1, v1.xy), ComplexMul(tw1, v1.zw));
        const float4 a2 = float4(ComplexMul(tw2, v2.xy), ComplexMul(tw2, v2.zw));
        const float4 a3 = float4(ComplexMul(tw3, v3.xy), ComplexMul(tw3, v3.zw));

        float4 y0, y1, y2, y3;
        Radix4Combine(a0, a1, a2, a3, y0, y1, y2, y3);

        const uint myDigit = (lane >> digitShift) & 3u;
        threadData = (myDigit == 0) ? y0 : (myDigit == 1) ? y1 : (myDigit == 2) ? y2 : y3;
    }

    // 1 radix-2 stage: bit 4, finishes off the 32-lane wave
    {
        uint2 inputIndices;
        float2 phaseRotation;
        ButterflyValues_Radix2(4, threadIdx, inputIndices, phaseRotation);

        const float4 partnerData = WaveReadLaneAt(threadData, WaveGetLaneIndex() ^ 16u);
        const bool isLow = (threadIdx & 16u) == 0;
        const float4 a = isLow ? threadData : partnerData;
        const float4 b = isLow ? partnerData : threadData;
        const float4 rotated = float4(ComplexMul(phaseRotation, b.xy), ComplexMul(phaseRotation, b.zw));
        threadData = isLow ? a + rotated : a - rotated;
    }

    s_SharedDataA[threadIdx] = half4(threadData);
    GroupMemoryBarrierWithGroupSync();
    startStage = 5;
#endif

    // Remaining radix-4 stages via LDS, ping-ponging exactly like the radix-2 path
    uint bitOffset = startStage;
    for (; bitOffset + 2 <= FFT_LOG2_SIZE; bitOffset += 2)
    {
        const uint logStep = 1u << bitOffset;
        uint4 inputIndices;
        float2 tw1, tw2, tw3;
        ButterflyValues_Radix4(logStep, threadIdx, inputIndices, tw1, tw2, tw3);

        const float4 v0 = pingPong ? s_SharedDataB[inputIndices.x] : s_SharedDataA[inputIndices.x];
        const float4 v1 = pingPong ? s_SharedDataB[inputIndices.y] : s_SharedDataA[inputIndices.y];
        const float4 v2 = pingPong ? s_SharedDataB[inputIndices.z] : s_SharedDataA[inputIndices.z];
        const float4 v3 = pingPong ? s_SharedDataB[inputIndices.w] : s_SharedDataA[inputIndices.w];

        const float4 a0 = v0;
        const float4 a1 = float4(ComplexMul(tw1, v1.xy), ComplexMul(tw1, v1.zw));
        const float4 a2 = float4(ComplexMul(tw2, v2.xy), ComplexMul(tw2, v2.zw));
        const float4 a3 = float4(ComplexMul(tw3, v3.xy), ComplexMul(tw3, v3.zw));

        float4 y0, y1, y2, y3;
        Radix4Combine(a0, a1, a2, a3, y0, y1, y2, y3);

        const uint myDigit = (threadIdx >> bitOffset) & 3u;
        const float4 result = (myDigit == 0) ? y0 : (myDigit == 1) ? y1 : (myDigit == 2) ? y2 : y3;

        if (pingPong)
        {
            s_SharedDataA[threadIdx] = half4(result);
        }
        else
        {
            s_SharedDataB[threadIdx] = half4(result);
        }

        pingPong = !pingPong;
        GroupMemoryBarrierWithGroupSync();
    }

    // Trailing radix-2 stage for the one leftover bit. Only fires when wave
    // ops are enabled -- without them FFT_LOG2_SIZE is consumed exactly by
    // radix-4 stages (guaranteed even), so this compiles away to nothing.
    if (bitOffset < FFT_LOG2_SIZE)
    {
        uint2 inputIndices;
        float2 phaseRotation;
        ButterflyValues_Radix2(bitOffset, threadIdx, inputIndices, phaseRotation);

        const float4 a = pingPong ? s_SharedDataB[inputIndices.x] : s_SharedDataA[inputIndices.x];
        const float4 b = pingPong ? s_SharedDataB[inputIndices.y] : s_SharedDataA[inputIndices.y];
        const float4 rotated = float4(ComplexMul(phaseRotation, b.xy), ComplexMul(phaseRotation, b.zw));
        const bool isLow = (threadIdx & (1u << bitOffset)) == 0;

        if (pingPong) 
        {
            s_SharedDataA[threadIdx] = isLow ? half4(a + rotated) : half4(a - rotated);
        }
        else
        {
            s_SharedDataB[threadIdx] = isLow ? half4(a + rotated) : half4(a - rotated);
        }

        pingPong = !pingPong;
        GroupMemoryBarrierWithGroupSync();
    }

    return pingPong ? s_SharedDataB[threadIdx] : s_SharedDataA[threadIdx];
}

// Only dispatch this for FFT_SIZE_MIN (256) or FFT_SIZE_LARGE (1024) --
// FFT_SIZE_REGULAR (512) will fail to compile here (see #error above).
[numthreads(FFT_SIZE, 1, 1)]
void FFT_Radix4_ComputeCS(uint3 dispatchThreadID : SV_DispatchThreadID, uint3 groupID : SV_GroupID)
{
    uint threadIdx = dispatchThreadID.x;
    uint2 targetIndex;
    if (Transpose)
    {
        targetIndex = dispatchThreadID.yx;
    }
    else
    {
        targetIndex = dispatchThreadID.xy;
    }

    half4 input = Target[int3(targetIndex, groupID.z)];
    half4 output = DoIFFT_Radix4(threadIdx, input);
    half4 scale = half4(1.0f.xxxx - 2.0f.xxxx * half((dispatchThreadID.x + dispatchThreadID.y) % 2).xxxx);
    Target[int3(targetIndex, groupID.z)] = output * scale;
}